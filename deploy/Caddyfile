# HTTPS in front of the site: Caddy obtains and renews the Let's Encrypt certificate for $DOMAIN by itself
# (ports 80 and 443 must reach this host and the DNS A record must point here before the first start).
{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Caddy replaces any client-sent X-Forwarded-For with the real address, so the rate limiter cannot be fooled
	reverse_proxy web:80
}
