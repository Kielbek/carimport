# Copy to .env (never commit it) and fill in before `docker compose -f docker-compose.prod.yml up`.

# --- database ---
DB_PASSWORD=change-me

# --- public address of the site (links in e-mails, Stripe return URLs, CORS) ---
FRONTEND_URL=https://carimport.eu

# --- seller (terms page reads frontend/src/app/core/site.config.ts; keep both in sync) ---
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_TAX_ID=
CONTACT_EMAIL=kontakt@carimport.eu

# --- Stripe (live keys from the dashboard; webhook endpoint: https://<domain>/api/v1/webhooks/stripe) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- e-mail with the report: SMTP of any provider (Resend, Postmark, SendGrid, Amazon SES, ...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Carglo <raport@carimport.eu>
MAIL_REPLY_TO=kontakt@carimport.eu

# --- address search and road distances: the public OpenStreetMap servers do not allow commercial traffic -
#     point these at self-hosted Nominatim / OSRM or a compatible paid provider; empty = built-in fallback ---
GEOCODER_URL=
ROUTER_URL=

# --- VIN decoding and CO2 (free public services; empty = off) ---
VPIC_URL=https://vpic.nhtsa.dot.gov/api
EPA_URL=https://www.fueleconomy.gov/ws/rest
